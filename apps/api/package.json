{
  "name": "@veska/api",
  "version": "0.1.0",
  "description": "Veska API server — Hono on Node.js",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --watch dist/index.js",
    "dev:ts": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@hono/zod-validator": "^0.4.3",
    "@slack/bolt": "^4.1.0",
    "@slack/web-api": "^7.8.0",
    "@veska-cloud/ai": "workspace:*",
    "@veska-cloud/notifications": "workspace:*",
    "@veska-cloud/rate-limit": "workspace:*",
    "@veska-cloud/storage": "workspace:*",
    "@veska/core": "workspace:*",
    "bullmq": "^5.34.0",
    "dotenv": "^16.4.7",
    "hono": "^4.6.20",
    "ioredis": "^5.4.2",
    "stripe": "^22.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
