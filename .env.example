# ──────────────────────────────────────────────────────────────
# Veska — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ──────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://veska:veska@localhost:5432/veska

# ── Redis / BullMQ ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── LLM Provider ──────────────────────────────────────────────
# Choose: anthropic | ollama | local | openai | azure | groq | together
# Default: anthropic (requires ANTHROPIC_API_KEY)
# For self-hosted / data-sovereign deployments: set LLM_PROVIDER=ollama
LLM_PROVIDER=anthropic

# Anthropic Claude (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# Ollama — local models, no data leaves your network (LLM_PROVIDER=ollama or local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# OpenAI-compatible — OpenAI, Azure, Groq, Together.ai, LM Studio, vLLM, Jan
# (used when LLM_PROVIDER=openai|azure|groq|together|local)
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ── App ports ─────────────────────────────────────────────────
ADMIN_PORT=3000
API_PORT=3001
MARKETING_PORT=3002
MARKETPLACE_PORT=3003

# ── API server ────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
JWT_SECRET=change-me-in-production

# ── Admin UI ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_IDENTITY_ID=  # UUID of the admin identity (public, used client-side)

# ── Admin (server-side) ───────────────────────────────────────
API_URL=http://localhost:3001
VESKA_TENANT_ID=          # UUID of the tenant to manage
VESKA_ADMIN_IDENTITY_ID=  # UUID of the admin identity

# ── Slack integration ─────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SLACK_APP_TOKEN=xapp-... # For Socket Mode in development

# ── Email (Resend) ────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM_ADDRESS=Veska <noreply@yourdomain.com>
EMAIL_FROM=Veska <notifications@veska.app>

# ── WhatsApp (Twilio) ─────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
WHATSAPP_WEBHOOK_SECRET=  # Shared HMAC secret for X-Hub-Signature-256 verification

# ── Telegram ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=...  # From @BotFather
TELEGRAM_WEBHOOK_SECRET=  # Secret token sent by Telegram in X-Telegram-Bot-Api-Secret-Token

# ── Magic links ───────────────────────────────────────────────
MAGIC_LINK_SECRET=change-me-32-chars-minimum
MAGIC_LINK_BASE_URL=http://localhost:3000

# ── Storage (local disk for OSS, S3/R2 for cloud) ────────────
# Set STORAGE_PROVIDER=local to force local disk even if AWS_S3_BUCKET is set.
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
UPLOAD_BASE_URL=http://localhost:3001/uploads
# Cloud storage (leave empty for local):
# AWS_S3_BUCKET=
# AWS_S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Stripe (optional — only needed for paid marketplace) ──────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Webhook signing ───────────────────────────────────────────
WEBHOOK_SECRET=your-webhook-signing-secret
EMAIL_WEBHOOK_SECRET=  # Secret verified via X-Webhook-Secret header or ?secret= query param

# ── Exchange rates (optional — falls back to static rates) ────
OPEN_EXCHANGE_RATES_APP_ID=

# ── Observability (optional) ──────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# AXIOM_TOKEN=...
