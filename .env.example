# ──────────────────────────────────────────────────────────────
# Veska — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ──────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://veska:veska@localhost:5432/veska

# ── Redis / BullMQ ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Anthropic ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── API server ────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Admin UI ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Slack integration ─────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SLACK_APP_TOKEN=xapp-... # For Socket Mode in development

# ── Magic links ───────────────────────────────────────────────
MAGIC_LINK_SECRET=change-me-32-chars-minimum
MAGIC_LINK_BASE_URL=http://localhost:3000

# ── Stripe (optional — only needed for paid marketplace) ──────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Observability (optional) ──────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# AXIOM_TOKEN=...
