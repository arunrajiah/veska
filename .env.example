# ──────────────────────────────────────────────────────────────
# Veska — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ──────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://veska:veska@localhost:5432/veska

# ── Redis / BullMQ ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Anthropic ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── API server ────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
JWT_SECRET=change-me-in-production

# ── Admin UI ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_IDENTITY_ID=  # UUID of the admin identity (public, used client-side)

# ── Admin (server-side) ───────────────────────────────────────
API_URL=http://localhost:3001
VESKA_TENANT_ID=          # UUID of the tenant to manage
VESKA_ADMIN_IDENTITY_ID=  # UUID of the admin identity

# ── Slack integration ─────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SLACK_APP_TOKEN=xapp-... # For Socket Mode in development

# ── Email (Resend) ────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM_ADDRESS=Veska <noreply@yourdomain.com>

# ── WhatsApp (Twilio) ─────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ── Telegram ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=...  # From @BotFather

# ── Magic links ───────────────────────────────────────────────
MAGIC_LINK_SECRET=change-me-32-chars-minimum
MAGIC_LINK_BASE_URL=http://localhost:3000

# ── Stripe (optional — only needed for paid marketplace) ──────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Observability (optional) ──────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# AXIOM_TOKEN=...
